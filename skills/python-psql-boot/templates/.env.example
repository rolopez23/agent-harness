# Copy to .env and adjust. Values match docker-compose.yml at the repo root.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_test
FRONTEND_URL=http://localhost:3000
# true = refuse to start when the DB is unreachable; false = start and report 503 on /api/health
DB_REQUIRED_AT_STARTUP=false
